# PostgreSQL (docker-compose.yml startet eine lokale Instanz mit genau diesen Werten)
DATABASE_URL=postgresql://lping:lping@localhost:5432/lping

# Solana RPC (Helius o. ä.) — Secrets gehören NIE in die versionierte Config/DB
RPC_PRIMARY_URL=
RPC_FALLBACK_URL=

# Fabriq-Spike: Basis-URL/Endpoint sind bis zur Endpoint-Analyse konfigurierbar
# (siehe packages/adapters/src/fabriq/SPIKE.md)
FABRIQ_API_BASE=
FABRIQ_TRENDING_PATH=

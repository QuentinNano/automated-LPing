{
  "name": "automated-lping",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter @lping/web exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot": "pnpm --filter @lping/bot start",
    "db:generate": "pnpm --filter @lping/db db:generate",
    "db:migrate": "pnpm --filter @lping/db db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}

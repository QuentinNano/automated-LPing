{
  "name": "automated-lping",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "einrichten": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit && pnpm --filter @lping/web exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot": "pnpm --filter @lping/bot start",
    "db:generate": "pnpm --filter @lping/db db:generate",
    "db:migrate": "pnpm --filter @lping/db db:migrate",
    "aufzeichnen": "bash scripts/track-forever.sh",
    "nachladen": "pnpm --filter @lping/bot exec tsx src/main.ts backfill",
    "abspielen": "pnpm --filter @lping/bot exec tsx src/main.ts replay",
    "sichern": "bash scripts/backup.sh sichern",
    "pruefen": "pnpm --filter @lping/bot exec tsx src/main.ts track --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@lping/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "//": "Das Prisma-CLI sucht die .env im Paketordner; sie liegt aber im Projektwurzelverzeichnis.",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:check": "tsx scripts/roundtrip.ts"
  },
  "dependencies": {
    "@lping/core": "workspace:*",
    "@prisma/client": "^6.16.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.19.2"
  }
}

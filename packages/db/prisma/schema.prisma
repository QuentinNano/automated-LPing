// Datenmodell gemäß KONZEPT.md Abschnitt 10.2.
// Alle Geldwerte in SOL als Decimal; Roh-Token-Beträge als String (Basiseinheiten).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CandidateSource {
  FABRIQ
  REPLICATED
}

enum LifecycleState {
  DISCOVERED
  REJECTED
  QUEUED
  OPENING
  ACTIVE
  REBALANCING
  CLOSING
  CLOSED
  FAILED
}

enum TxKind {
  OPEN
  ADD_LIQUIDITY
  CLAIM
  REBALANCE
  REMOVE_LIQUIDITY
  CLOSE
  SWAP
  SWEEP
}

enum TxStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
  EXPIRED
}

enum BlacklistKind {
  MINT
  DEPLOYER
  POOL
}

/// Entdeckte Pools inkl. Filter-Ergebnis; abgelehnte Kandidaten werden für das
/// Shadow-Tracking (Filter-Kalibrierung) weiterverfolgt.
model PoolCandidate {
  id              String          @id @default(cuid())
  poolAddress String          @map("pool_address")
  source      CandidateSource
  /// Preset-ID aus der Konfiguration (frei benennbar, z. B. "konservativ").
  preset      String
  status      LifecycleState  @default(DISCOVERED)
  score           Decimal?        @db.Decimal(6, 2)
  rawMetrics      Json            @map("raw_metrics")
  filterResult    Json?           @map("filter_result")
  rejectionReason String?         @map("rejection_reason")
  shadowUntil     DateTime?       @map("shadow_until")
  discoveredAt    DateTime        @default(now()) @map("discovered_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  positions       Position[]

  @@index([poolAddress])
  @@index([status, discoveredAt])
  @@map("pool_candidates")
}

model Position {
  id              String         @id @default(cuid())
  candidateId     String?        @map("candidate_id")
  candidate       PoolCandidate? @relation(fields: [candidateId], references: [id])
  poolAddress     String         @map("pool_address")
  /// On-Chain-Adresse des Positions-Accounts (nach OPENING bekannt).
  positionPubkey  String?        @unique @map("position_pubkey")
  /// Preset-ID aus der Konfiguration (frei benennbar).
  preset          String
  state           LifecycleState @default(OPENING)
  strategyType    String         @map("strategy_type")
  sided           String
  minBinId        Int?           @map("min_bin_id")
  maxBinId        Int?           @map("max_bin_id")
  binStep         Int?           @map("bin_step")
  mintX           String         @map("mint_x")
  mintY           String         @map("mint_y")
  depositSol      Decimal        @map("deposit_sol") @db.Decimal(20, 9)
  currentValueSol Decimal?       @map("current_value_sol") @db.Decimal(20, 9)
  realizedPnlSol  Decimal        @default(0) @map("realized_pnl_sol") @db.Decimal(20, 9)
  feesEarnedSol   Decimal        @default(0) @map("fees_earned_sol") @db.Decimal(20, 9)
  costsSol        Decimal        @default(0) @map("costs_sol") @db.Decimal(20, 9)
  /// Wert bei reinem Halten (HODL-Benchmark) zum letzten Tick.
  hodlValueSol    Decimal?       @map("hodl_value_sol") @db.Decimal(20, 9)
  timeInRangePct  Decimal?       @map("time_in_range_pct") @db.Decimal(6, 2)
  entryPrice      Decimal?       @map("entry_price") @db.Decimal(30, 15)
  lastPrice       Decimal?       @map("last_price") @db.Decimal(30, 15)
  closeReason     String?        @map("close_reason")
  /// Serialisierter Simulationszustand der Paper-Engine (PaperPositionState).
  simState        Json?          @map("sim_state")
  paper           Boolean        @default(true)
  openedAt        DateTime?      @map("opened_at")
  closedAt        DateTime?      @map("closed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  events          PositionEvent[]
  transactions    Transaction[]
  feeClaims       FeeClaim[]

  @@index([state])
  @@index([poolAddress])
  @@index([preset, state])
  @@map("positions")
}

/// Audit-Trail: jeder Zustandsübergang mit Auslöser und Kontext.
model PositionEvent {
  id         String          @id @default(cuid())
  positionId String          @map("position_id")
  position   Position        @relation(fields: [positionId], references: [id])
  fromState  LifecycleState? @map("from_state")
  toState    LifecycleState  @map("to_state")
  trigger    String
  context    Json?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([positionId, createdAt])
  @@map("position_events")
}

model Transaction {
  id                  String    @id @default(cuid())
  positionId          String?   @map("position_id")
  position            Position? @relation(fields: [positionId], references: [id])
  signature           String?   @unique
  kind                TxKind
  status              TxStatus  @default(PENDING)
  priorityFeeLamports BigInt?   @map("priority_fee_lamports")
  feeLamports         BigInt?   @map("fee_lamports")
  slot                BigInt?
  error               String?
  payload             Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  confirmedAt         DateTime? @map("confirmed_at")

  @@index([positionId])
  @@index([status])
  @@map("transactions")
}

model FeeClaim {
  id                      String   @id @default(cuid())
  positionId              String   @map("position_id")
  position                Position @relation(fields: [positionId], references: [id])
  claimTransactionId      String?  @map("claim_transaction_id")
  amountXRaw              String   @map("amount_x_raw")
  amountYRaw              String   @map("amount_y_raw")
  valueSolAtClaim         Decimal  @map("value_sol_at_claim") @db.Decimal(20, 9)
  convertedSol            Decimal? @map("converted_sol") @db.Decimal(20, 9)
  conversionTransactionId String?  @map("conversion_transaction_id")
  claimedAt               DateTime @default(now()) @map("claimed_at")

  @@index([positionId])
  @@map("fee_claims")
}

/// Zeitreihe für aktive UND geschattete Pools (Scoring, Backtesting, Dashboard).
///
/// Diese Tabelle ist die Grundlage des Replays (KONZEPT-ML.md 5): Aus ihr werden
/// die MarketTicks rekonstruiert, gegen die optimiert wird. Was hier nicht steht,
/// kann der Replay nicht sehen — und nachträglich beschaffen lässt es sich nicht.
model PoolSnapshot {
  id           String   @id @default(cuid())
  poolAddress  String   @map("pool_address")
  ts           DateTime @default(now())
  tvlUsd       Decimal? @map("tvl_usd") @db.Decimal(20, 2)
  volume24hUsd Decimal? @map("volume_24h_usd") @db.Decimal(20, 2)
  fees24hUsd   Decimal? @map("fees_24h_usd") @db.Decimal(20, 2)
  feeTvl24hPct Decimal? @map("fee_tvl_24h_pct") @db.Decimal(10, 4)
  priceNative  Decimal? @map("price_native") @db.Decimal(30, 15)
  binStep      Int?     @map("bin_step")
  /// Gesamtgebühr (Basis + Volatilitätsaufschlag) zum Messzeitpunkt, in %.
  /// Der Satz, mit dem Swaps tatsächlich belastet werden — bei volatilen Pools
  /// ein Mehrfaches der Basisgebühr.
  dynamicFeePct  Decimal? @map("dynamic_fee_pct") @db.Decimal(10, 4)
  baseFeePct     Decimal? @map("base_fee_pct") @db.Decimal(10, 4)
  /// Protokollanteil in % **der Gebühr** (10 % Standard, 20 % Launch-Pool).
  /// Ohne diesen Abzug wird der LP-Ertrag systematisch zu hoch angesetzt.
  protocolFeePct Decimal? @map("protocol_fee_pct") @db.Decimal(10, 4)
  /// USD-Preis von SOL zum Messzeitpunkt — für die Umrechnung des Pool-TVL
  /// in SOL. Im Bin-Modell des Gebührenanteils kürzt sich der Kurs nicht heraus.
  solPriceUsd    Decimal? @map("sol_price_usd") @db.Decimal(20, 6)
  /// Volumen/Gebühren/Fee-TVL/Protokollgebühren je Zeitfenster (30m…24h).
  /// Als JSON, damit ein zusätzliches Fenster keine Migration braucht.
  windows        Json?
  extra          Json?

  @@index([poolAddress, ts])
  @@map("pool_snapshots")
}

/// Kerzen der Pool-Historie, nachgeladen über die Historien-Endpunkte der
/// DLMM-API (KONZEPT-ML.md 3.3).
///
/// Bewusst eine eigene Tabelle statt zusätzlicher Spalten in `pool_snapshots`:
/// Eine Kerze ist eine andere Art von Beobachtung. Volumen und Gebühren gelten
/// für ein **abgeschlossenes Fenster**, nicht als gleitende 24-Stunden-Summe,
/// und sie trägt High/Low, die eine Stichprobe nicht haben kann. Beides unter
/// denselben Spaltennamen zu mischen hieße, zwei Bedeutungen zu verwechseln —
/// und ein 5-Minuten-Volumen für ein Tagesvolumen zu halten, wäre ein Faktor 288.
///
/// Was hier fehlt und nur die laufende Aufzeichnung liefert: TVL, dynamische
/// Gebühr, SOL-Kurs.
model PoolHistoryCandle {
  poolAddress     String   @map("pool_address")
  /// Beginn des Fensters.
  ts              DateTime
  /// Fensterlänge, wie von der API benannt (`5m` … `24h`).
  timeframe       String
  open            Decimal? @db.Decimal(30, 15)
  high            Decimal? @db.Decimal(30, 15)
  low             Decimal? @db.Decimal(30, 15)
  close           Decimal? @db.Decimal(30, 15)
  volumeUsd       Decimal? @map("volume_usd") @db.Decimal(20, 2)
  /// Gesamtgebühren des Fensters, vor Protokollabzug.
  feesUsd         Decimal? @map("fees_usd") @db.Decimal(20, 2)
  /// Protokollanteil des Fensters — aus ihm folgt der LP-Anteil je Kerze,
  /// statt ihn aus einer Pool-Konfiguration zu schätzen.
  protocolFeesUsd Decimal? @map("protocol_fees_usd") @db.Decimal(20, 2)
  fetchedAt       DateTime @default(now()) @map("fetched_at")

  /// Der zusammengesetzte Schlüssel macht das Nachladen idempotent: Ein zweiter
  /// Lauf über denselben Zeitraum ersetzt, statt zu verdoppeln.
  @@id([poolAddress, timeframe, ts])
  @@index([poolAddress, ts])
  @@map("pool_history_candles")
}

/// Append-only Konfigurations-Historie (ConfigService-Persistenz).
model ConfigVersion {
  version   Int      @id @default(autoincrement())
  config    Json
  actor     String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("config_versions")
}

/// Pools, deren Verlauf für die Strategie-Optimierung aufgezeichnet wird
/// (KONZEPT-ML.md Abschnitt 3). Bewusst unabhängig davon, ob eine Position
/// eröffnet wurde — nur so entsteht ein verzerrungsfreier Datensatz.
model TrackedPool {
  poolAddress   String    @id @map("pool_address")
  tokenMint     String    @map("token_mint")
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  trackUntil    DateTime  @map("track_until")
  lastTrackedAt DateTime? @map("last_tracked_at")
  /// Anzahl geschriebener Messpunkte (Datenqualitäts-Kennzahl).
  pointCount    Int       @default(0) @map("point_count")
  active        Boolean   @default(true)

  @@index([active, lastTrackedAt])
  @@map("tracked_pools")
}

/// Merkmale eines Kandidaten zum Entscheidungszeitpunkt. Enthält per
/// Konstruktion keine Information aus der Zukunft (Look-Ahead-Bias).
model CandidateFeature {
  id             String             @id @default(cuid())
  poolAddress    String             @map("pool_address")
  tokenMint      String             @map("token_mint")
  preset         String
  capturedAt     DateTime           @default(now()) @map("captured_at")
  featureVersion Int                @map("feature_version")
  features       Json
  score          Decimal?           @db.Decimal(6, 2)
  verdict        String
  rejectedBy     String?            @map("rejected_by")
  outcomes       CandidateOutcome[]

  @@index([poolAddress, capturedAt])
  @@index([capturedAt])
  @@map("candidate_features")
}

/// Ergebnis-Labels je Horizont, ausschließlich aus der Zeit NACH der
/// Entscheidung berechnet.
model CandidateOutcome {
  id             String           @id @default(cuid())
  featureId      String           @map("feature_id")
  feature        CandidateFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  horizonHours   Int              @map("horizon_hours")
  priceChangePct Decimal?         @map("price_change_pct") @db.Decimal(14, 4)
  tvlChangePct   Decimal?         @map("tvl_change_pct") @db.Decimal(14, 4)
  feeYieldPct    Decimal?         @map("fee_yield_pct") @db.Decimal(14, 4)
  maxDrawdownPct Decimal?         @map("max_drawdown_pct") @db.Decimal(14, 4)
  rugged         Boolean          @default(false)
  observations   Int              @default(0)
  coveredHours   Decimal          @default(0) @map("covered_hours") @db.Decimal(10, 3)
  computedAt     DateTime         @default(now()) @map("computed_at")

  @@unique([featureId, horizonHours])
  @@map("candidate_outcomes")
}

model BlacklistEntry {
  id        String        @id @default(cuid())
  kind      BlacklistKind
  address   String
  reason    String
  source    String        @default("auto")
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([kind, address])
  @@map("blacklist")
}
